{
  "name": "pinnacle-achievers-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "check:seo": "npm run build && node scripts/check-seo.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "dev:cloudflare": "npm run build && wrangler dev",
    "db:create": "wrangler d1 create pinnacle-students",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:original": "npm run build && wrangler deploy --name pinnacle-achievers-academy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
